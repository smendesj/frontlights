{
  "repository": "OWNER/REPOSITORY",
  "project": null,
  "roads": null,
  "homolog": {
    "backupDir": null
  },
  "roadmapSync": {
    "enabled": false,
    "endpoint": "https://roads.example.com/api/frontlights",
    "secretEnvVar": "FRONTLIGHTS_API_SECRET",
    "scrumRoot": "%USERPROFILE%\\PASTA\\SCRUM",
    "roadmapFile": "{yyyy}/ROADMAP.md",
    "weekFolderPattern": "{yyyy}/{dd_MM}",
    "sprintFilePattern": "SPRINT_{dd_MM}_a_{dd_MM}.md",
    "maxSprintItems": 4,
    "markCompleted": true,
    "issueTargets": {
      "PRODUTO": {
        "repository": "OWNER/REPOSITORY",
        "project": {
          "owner": "OWNER",
          "number": 1
        }
      }
    },
    "progress": {
      "enabled": false,
      "path": "progress-report",
      "collectors": [
        {
          "name": "usage",
          "command": [
            "node",
            "COLLECTOR_SCRIPT",
            "--start",
            "{start}",
            "--end",
            "{end}"
          ],
          "timeoutSeconds": 300
        }
      ],
      "pushCommand": [
        "node",
        "PUSH_SCRIPT",
        "--draft",
        "{draft}"
      ],
      "factsFile": null,
      "usageFile": null,
      "draftGuide": "docs/progress-draft.md",
      "shotsDir": ".frontlights/progress/shots"
    }
  },
  "browserTest": {
    "baseUrl": "http://127.0.0.1:{port}/",
    "frontPaths": [
      "web/src/**"
    ],
    "users": [
      {
        "login": "usuario1@exemplo.test",
        "password": "senha-ficticia"
      },
      {
        "login": "usuario2@exemplo.test",
        "password": "senha-ficticia"
      }
    ],
    "processes": [
      {
        "name": "web",
        "argv": [
          "python",
          "APP_SCRIPT",
          "{port}"
        ],
        "port": "auto",
        "health": "http://127.0.0.1:{port}/health",
        "timeoutSeconds": 60
      }
    ],
    "isolated": {
      "baseUrl": "http://127.0.0.1:{port}/",
      "processes": [
        {
          "name": "web",
          "argv": [
            "python",
            "APP_SCRIPT",
            "{port}"
          ],
          "port": "auto",
          "health": "http://127.0.0.1:{port}/health",
          "timeoutSeconds": 60
        }
      ],
      "copyDatabase": {
        "argv": [
          "python",
          "COPY_DB_SCRIPT"
        ],
        "timeoutSeconds": 600
      },
      "dropDatabase": {
        "argv": [
          "python",
          "DROP_DB_SCRIPT"
        ],
        "timeoutSeconds": 120
      }
    }
  },
  "checks": {
    "backend": "web",
    "regression": {
      "argv": [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "timeoutSeconds": 900
    },
    "integration": {
      "argv": [
        "python",
        "INTEGRATION_SCRIPT",
        "{backend_url}"
      ],
      "timeoutSeconds": 300
    },
    "smoke": {
      "target": "web",
      "paths": [
        "/",
        "/health"
      ],
      "expectStatus": [
        200,
        302
      ],
      "timeoutSeconds": 30
    }
  },
  "preview": {
    "worktree": ".claude/worktrees/previa",
    "branch": "previa",
    "baseUrl": "http://127.0.0.1:8070/",
    "processes": [
      {
        "name": "web",
        "argv": [
          "python",
          "APP_SCRIPT",
          "8070"
        ],
        "port": 8070,
        "health": "http://127.0.0.1:8070/health",
        "timeoutSeconds": 60
      }
    ]
  }
}
